// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  OTHER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  customer     Customer?
  resetTokens  PasswordResetToken[]

  @@map("users")
  auditLogs AuditLog[]
  payments Payment[]
  discounts Discount[]
  subscriptionStatusHistories SubscriptionStatusHistory[]
  subscriptions Subscription[]
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relationship
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @unique @map("user_id") @db.Uuid

  companyName     String?  @map("company_name") @db.VarChar(150)
  phone           String?  @db.VarChar(20)
  billingAddress String?  @map("billing_address") @db.Text
  taxNumber       String?  @map("tax_number") @db.VarChar(50)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  user            User?          @relation(fields: [userId], references: [id])
  subscriptions   Subscription[]
  invoices        Invoice[]

  @@map("customers")
}

model Tax {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  rate      Decimal  @db.Decimal(5, 2)
  isActive  Boolean  @default(true) @map("is_active")

  // Relationships
  products           Product[]
  subscriptionLines  SubscriptionLine[]

  @@map("taxes")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  type         String   @db.VarChar(50)

  salesPrice   Decimal  @map("sales_price") @db.Decimal(12, 2)
  costPrice    Decimal  @map("cost_price") @db.Decimal(12, 2)

  defaultTaxId String?  @map("default_tax_id") @db.Uuid
  notes        String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  defaultTax             Tax?                       @relation(fields: [defaultTaxId], references: [id])
  variants               ProductVariant[]
  planProducts           PlanProduct[]
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]
  discountProducts       DiscountProduct[]

  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid

  attribute  String   @db.VarChar(50)
  value      String   @db.VarChar(100)
  extraPrice Decimal  @default(0) @map("extra_price") @db.Decimal(12, 2)

  isActive   Boolean  @default(true) @map("is_active")

  // Relationships
  product               Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  planProducts          PlanProduct[]
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines     SubscriptionLine[]
  invoiceLines          InvoiceLine[]

  @@unique([productId, attribute, value])
  @@map("product_variants")
}

model PaymentTerm {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique @db.VarChar(50)
  dueDays  Int    @map("due_days")

  // Relationships
  subscriptions Subscription[]

  @@map("payment_terms")
}

model Plan {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(150)
  description     String?       @db.Text

  price           Decimal       @db.Decimal(12, 2)
  billingPeriod   BillingPeriod @map("billing_period")

  minQuantity     Int           @default(1) @map("min_quantity")

  availableFrom   DateTime?     @map("available_from") @db.Date
  availableTo     DateTime?     @map("available_to") @db.Date

  autoClose       Boolean       @default(false) @map("auto_close")
  allowEarlyClose Boolean       @default(true) @map("allow_early_close")
  allowPause      Boolean       @default(true) @map("allow_pause")
  allowRenewal    Boolean       @default(true) @map("allow_renewal")

  isActive        Boolean       @default(true) @map("is_active")

  // Relationships
  planProducts        PlanProduct[]
  quotationTemplates  QuotationTemplate[]
  subscriptions       Subscription[]

  @@map("plans")
}

model PlanProduct {
  id              String   @id @default(uuid()) @db.Uuid

  planId          String   @map("plan_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid

  defaultQuantity Int      @default(1) @map("default_quantity")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)

  // Relationships
  plan     Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([planId, productId, variantId])
  @@map("plan_products")
}

model QuotationTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(150)

  planId        String   @map("plan_id") @db.Uuid
  validityDays  Int      @map("validity_days")

  description   String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")

  // Relationships
  plan          Plan                     @relation(fields: [planId], references: [id])
  templateLines QuotationTemplateLine[]
  subscriptions Subscription[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String  @id @default(uuid()) @db.Uuid

  templateId String  @map("template_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid

  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)

  // Relationships
  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])

  @@map("quotation_template_lines")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  number               String             @unique @db.VarChar(30)

  customerId           String             @map("customer_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  templateId           String?            @map("template_id") @db.Uuid

  status               SubscriptionStatus @default(DRAFT)

  quotationValidUntil  DateTime?          @map("quotation_valid_until") @db.Date

  startDate            DateTime           @map("start_date") @db.Date
  expiryDate           DateTime?          @map("expiry_date") @db.Date

  paymentTermId        String             @map("payment_term_id") @db.Uuid
  nextBillingDate      DateTime?          @map("next_billing_date") @db.Date

  createdBy            String?            @map("created_by") @db.Uuid

  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  customer       Customer                 @relation(fields: [customerId], references: [id])
  plan           Plan                     @relation(fields: [planId], references: [id])
  template       QuotationTemplate?       @relation(fields: [templateId], references: [id])
  paymentTerm    PaymentTerm              @relation(fields: [paymentTermId], references: [id])
  creator        User?                    @relation(fields: [createdBy], references: [id])

  lines          SubscriptionLine[]
  statusHistory  SubscriptionStatusHistory[]
  invoices       Invoice[]
  discountLinks  DiscountSubscription[]

  @@index([status, nextBillingDate])
  @@index([customerId])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String   @id @default(uuid()) @db.Uuid

  subscriptionId String   @map("subscription_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  taxId          String?  @map("tax_id") @db.Uuid

  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(12, 2)

  // Relationships
  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  tax          Tax?           @relation(fields: [taxId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_lines")
}

model SubscriptionStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid

  subscriptionId String             @map("subscription_id") @db.Uuid

  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus  @map("to_status")

  changedBy      String?            @map("changed_by") @db.Uuid
  changedAt      DateTime           @default(now()) @map("changed_at") @db.Timestamptz

  note           String?            @db.Text

  // Relationships
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  changedByUser User?        @relation(fields: [changedBy], references: [id])

  @@index([subscriptionId, changedAt])
  @@map("subscription_status_history")
}

model Discount {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(150)

  type              DiscountType
  value             Decimal      @db.Decimal(12, 2)
  scope             DiscountScope

  minPurchaseAmount Decimal?     @map("min_purchase_amount") @db.Decimal(12, 2)
  minQuantity       Int?         @map("min_quantity")

  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime?    @map("end_date") @db.Date

  usageLimit        Int?         @map("usage_limit")
  usageCount        Int          @default(0) @map("usage_count")

  isActive          Boolean      @default(true) @map("is_active")
  createdBy         String       @map("created_by") @db.Uuid

  // Relationships
  creator       User                     @relation(fields: [createdBy], references: [id])
  products      DiscountProduct[]
  subscriptions DiscountSubscription[]
  applications DiscountApplication[]

  @@map("discounts")
}

model DiscountProduct {
  discountId String @map("discount_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid

  // Relationships
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@id([discountId, productId])
  @@map("discount_products")
}

model DiscountSubscription {
  discountId     String @map("discount_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid

  // Relationships
  discount     Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@id([discountId, subscriptionId])
  @@map("discount_subscriptions")
}

model DiscountApplication {
  id             String   @id @default(uuid()) @db.Uuid

  discountId     String   @map("discount_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  invoiceLineId  String?  @map("invoice_line_id") @db.Uuid

  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  appliedAt      DateTime @default(now()) @map("applied_at") @db.Timestamptz

  // Relationships
  discount    Discount    @relation(fields: [discountId], references: [id])
  invoice     Invoice     @relation(fields: [invoiceId], references: [id])
  invoiceLine InvoiceLine? @relation(fields: [invoiceLineId], references: [id])

  @@index([discountId])
  @@index([invoiceId])
  @@map("discount_applications")
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  number            String        @unique @db.VarChar(30)

  subscriptionId    String        @map("subscription_id") @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid

  status            InvoiceStatus @default(DRAFT)

  invoiceDate       DateTime      @map("invoice_date") @db.Date
  dueDate           DateTime      @map("due_date") @db.Date

  billingPeriodStart DateTime     @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime     @map("billing_period_end") @db.Date

  // Customer details snapshot
  billToName        String?       @map("bill_to_name") @db.VarChar(150)
  billToAddress     String?       @map("bill_to_address") @db.Text

  // Financial details
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal        Decimal       @map("grand_total") @db.Decimal(12, 2)

  amountPaid        Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)

  sentAt            DateTime?     @map("sent_at") @db.Timestamptz

  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  subscription       Subscription          @relation(fields: [subscriptionId], references: [id])
  customer           Customer              @relation(fields: [customerId], references: [id])
  lines              InvoiceLine[]
  payments           Payment[]
  discountApplications DiscountApplication[]

  @@unique([subscriptionId, billingPeriodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([subscriptionId])
  @@map("invoices")
}

model InvoiceLine {
  id              String   @id @default(uuid()) @db.Uuid

  invoiceId       String   @map("invoice_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid

  description     String   @db.Text
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)

  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  netAmount       Decimal  @map("net_amount") @db.Decimal(12, 2)

  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)

  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)

  // Relationships
  invoice              Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product              Product                @relation(fields: [productId], references: [id])
  variant              ProductVariant?        @relation(fields: [variantId], references: [id])
  discountApplications DiscountApplication[]

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid

  invoiceId   String        @map("invoice_id") @db.Uuid

  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)

  paymentDate DateTime      @map("payment_date") @db.Date
  reference   String?       @unique @db.VarChar(100)
  notes       String?       @db.Text

  recordedBy  String        @map("recorded_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  recorder    User    @relation(fields: [recordedBy], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid

  userId     String?  @map("user_id") @db.Uuid

  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @db.Uuid

  oldValues  Json?    @map("old_values") @db.JsonB
  newValues  Json?    @map("new_values") @db.JsonB

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relationship
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}



