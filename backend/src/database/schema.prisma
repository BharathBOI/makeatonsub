generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  SUBSCRIPTION
  PRODUCT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  OTHER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(CUSTOMER)

  // Customer profile details
  companyName    String? @map("company_name") @db.VarChar(150)
  phone          String? @db.VarChar(30)
  billingAddress String? @map("billing_address") @db.Text
  taxNumber      String? @map("tax_number") @db.VarChar(50)

  // Password reset token and expiry
  resetToken       String?   @unique @map("reset_token") @db.VarChar(255)
  resetTokenExpiry DateTime? @map("reset_token_expiry") @db.Timestamptz

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  subscriptions    Subscription[] @relation("CustomerSubscriptions")
  invoices         Invoice[]      @relation("CustomerInvoices")
  paymentsRecorded Payment[]      @relation("PaymentsRecorded")

  @@map("users")
}

model Tax {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(100)
  rate     Decimal @db.Decimal(5, 2)
  isActive Boolean @default(true) @map("is_active")

  // Relationships
  products          Product[]
  subscriptionLines SubscriptionLine[]

  @@map("taxes")
}

model Product {
  id         String  @id @default(uuid()) @db.Uuid
  name       String  @db.VarChar(150)
  type       String  @db.VarChar(50)
  salesPrice Decimal @map("sales_price") @db.Decimal(12, 2)
  costPrice  Decimal @default(0) @map("cost_price") @db.Decimal(12, 2)
  notes      String? @db.Text
  taxId      String? @map("tax_id") @db.Uuid
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  tax                    Tax?                    @relation(fields: [taxId], references: [id])
  variants               ProductVariant[]
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]
  discounts              Discount[]

  @@map("products")
}

model ProductVariant {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  attribute  String  @db.VarChar(50)
  value      String  @db.VarChar(100)
  extraPrice Decimal @default(0) @map("extra_price") @db.Decimal(12, 2)
  isActive   Boolean @default(true) @map("is_active")

  // Relationships
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]

  @@unique([productId, attribute, value])
  @@map("product_variants")
}

model Plan {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(150)
  description   String?       @db.Text
  price         Decimal       @db.Decimal(12, 2)
  billingPeriod BillingPeriod @map("billing_period")
  minQuantity   Int           @default(1) @map("min_quantity")

  availableFrom DateTime? @map("available_from") @db.Date
  availableTo   DateTime? @map("available_to") @db.Date

  autoClose       Boolean @default(false) @map("auto_close")
  allowEarlyClose Boolean @default(true) @map("allow_early_close")
  allowPause      Boolean @default(true) @map("allow_pause")
  allowRenewal    Boolean @default(true) @map("allow_renewal")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  quotationTemplates QuotationTemplate[]
  subscriptions      Subscription[]

  @@map("plans")
}

model QuotationTemplate {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(150)
  planId       String  @map("plan_id") @db.Uuid
  validityDays Int     @default(30) @map("validity_days")
  description  String? @db.Text
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  plan          Plan                    @relation(fields: [planId], references: [id])
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String  @id @default(uuid()) @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid
  quantity   Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)

  // Relationships
  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])

  @@map("quotation_template_lines")
}

model Discount {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(150)
  code      String?       @unique @db.VarChar(50)
  type      DiscountType
  value     Decimal       @db.Decimal(12, 2)
  scope     DiscountScope @default(SUBSCRIPTION)
  productId String?       @map("product_id") @db.Uuid

  minPurchaseAmount Decimal? @map("min_purchase_amount") @db.Decimal(12, 2)
  minQuantity       Int?     @map("min_quantity")

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  usageLimit Int? @map("usage_limit")
  usageCount Int  @default(0) @map("usage_count")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  product       Product?       @relation(fields: [productId], references: [id])
  subscriptions Subscription[]

  @@map("discounts")
}

model Subscription {
  id         String  @id @default(uuid()) @db.Uuid
  number     String  @unique @db.VarChar(30)
  customerId String  @map("customer_id") @db.Uuid
  planId     String  @map("plan_id") @db.Uuid
  templateId String? @map("template_id") @db.Uuid
  discountId String? @map("discount_id") @db.Uuid

  status              SubscriptionStatus @default(DRAFT)
  quotationValidUntil DateTime?          @map("quotation_valid_until") @db.Date
  startDate           DateTime           @map("start_date") @db.Date
  expiryDate          DateTime?          @map("expiry_date") @db.Date
  nextBillingDate     DateTime?          @map("next_billing_date") @db.Date
  paymentTerms        String             @default("Immediate") @map("payment_terms") @db.VarChar(50)
  notes               String?            @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  customer User               @relation("CustomerSubscriptions", fields: [customerId], references: [id])
  plan     Plan               @relation(fields: [planId], references: [id])
  template QuotationTemplate? @relation(fields: [templateId], references: [id])
  discount Discount?          @relation(fields: [discountId], references: [id])
  lines    SubscriptionLine[]
  invoices Invoice[]

  @@index([status, nextBillingDate])
  @@index([customerId])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String  @id @default(uuid()) @db.Uuid
  subscriptionId String  @map("subscription_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  taxId          String? @map("tax_id") @db.Uuid

  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  amount    Decimal @map("amount") @db.Decimal(12, 2)

  // Relationships
  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  tax          Tax?            @relation(fields: [taxId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_lines")
}

model Invoice {
  id             String @id @default(uuid()) @db.Uuid
  number         String @unique @db.VarChar(30)
  subscriptionId String @map("subscription_id") @db.Uuid
  customerId     String @map("customer_id") @db.Uuid

  status             InvoiceStatus @default(DRAFT)
  invoiceDate        DateTime      @map("invoice_date") @db.Date
  dueDate            DateTime      @map("due_date") @db.Date
  billingPeriodStart DateTime      @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime      @map("billing_period_end") @db.Date

  // Customer snapshot
  customerName   String  @map("customer_name") @db.VarChar(150)
  customerEmail  String  @map("customer_email") @db.VarChar(255)
  billingAddress String? @map("billing_address") @db.Text

  // Financial summary
  subtotal      Decimal @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal    Decimal @map("grand_total") @db.Decimal(12, 2)
  amountPaid    Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relationships
  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  customer     User          @relation("CustomerInvoices", fields: [customerId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([subscriptionId, billingPeriodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([subscriptionId])
  @@map("invoices")
}

model InvoiceLine {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  description    String  @db.VarChar(255)
  quantity       Int     @default(1)
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(12, 2)

  // Relationships
  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paymentDate  DateTime      @map("payment_date") @db.Date
  reference    String?       @db.VarChar(100)
  notes        String?       @db.Text
  recordedById String?       @map("recorded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("PaymentsRecorded", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}
